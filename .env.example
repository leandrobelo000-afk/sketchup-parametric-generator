# Copie para .env na raiz do repositório. Nunca versione o .env.
# mock (padrão) não chama a IA; gemini usa a chave abaixo.
SKETCHUP_AI_PROVEDOR=mock
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
# 0 desliga o registro local (~/.sketchup_ai_assistant/dataset) dos modelos aprovados na janela do app
SKETCHUP_AI_SALVAR_DATASET=1
